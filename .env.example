# ============================================================================
# scalix26 — environment template. Copy to .env.local and fill in.
#
#   cp .env.example .env.local
#
# NO REAL VALUES BELONG IN THIS FILE. It is committed; .env.local is not.
#
# Only the four in REQUIRED are needed to boot the app. Everything below that
# turns a feature on: leave a key empty and its feature reports itself as
# unconfigured rather than crashing — that is the deliberate pattern here, and
# it is what lets a new developer run the app without an account at Twilio,
# Stripe, Meta and Intuit on day one.
#
# `true` / `false` / `1` are compared as STRINGS. LEARNING_ENABLED=false is off;
# LEARNING_ENABLED=0 is on, because it is not the string "false".
# ============================================================================


# ── REQUIRED — the app will not start usefully without these ────────────────

# Supabase project URL. Dashboard → Project Settings → Data API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key. Same page. Public by design — RLS is the guard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key. Same page. BYPASSES RLS — server-only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Absolute base URL of this deployment, no trailing slash. http://localhost:3000 locally.
# Used to build every callback, webhook and customer-facing document link.
NEXT_PUBLIC_APP_URL=


# ── AI ──────────────────────────────────────────────────────────────────────

# Anthropic API key for the AI employee, learning jobs and the catalog worker.
# console.anthropic.com → API keys. Metered — see the sandbox notes in README.
ANTHROPIC_API_KEY=


# ── Telephony and SMS (Twilio) ──────────────────────────────────────────────

# Twilio Account SID (starts AC…). console.twilio.com → Account Info.
TWILIO_ACCOUNT_SID=
# Twilio Auth Token. Same panel. Also verifies inbound webhook signatures.
TWILIO_AUTH_TOKEN=
# The E.164 number calls and texts are sent from, e.g. +16045550123.
TWILIO_PHONE_NUMBER=
# Send SMS through a Messaging Service instead of the bare number. "true" to enable.
SMS_VIA_MESSAGING_SERVICE=
# Messaging Service SID (starts MG…). Only read when the flag above is "true".
TWILIO_MESSAGING_SERVICE_SID=
# wss:// URL of the voice-server sidecar that Twilio streams audio to.
# Empty = no media-stream leg; calls fall back to the non-streaming path.
VOICE_SERVER_WS_URL=


# ── Speech (Deepgram) ───────────────────────────────────────────────────────

# Deepgram API key — transcription, and the Aura voices. console.deepgram.com.
DEEPGRAM_API_KEY=


# ── Email (Resend) ──────────────────────────────────────────────────────────

# Resend API key. resend.com → API Keys.
RESEND_API_KEY=
# From-address for outbound mail. Must be a domain verified IN THE SAME Resend
# account as the key above. Defaults to noreply@scalix26.com when empty.
EMAIL_FROM_ADDRESS=
# From-address for replyable threads, when it differs. Falls back to the above.
EMAIL_INBOUND_FROM_ADDRESS=
# Shared secret on the Resend inbound-email webhook. Resend → Webhooks → Signing secret.
RESEND_WEBHOOK_SECRET=
# Legacy alias for the same secret, still read as a fallback. Prefer the one above.
RESEND_INBOUND_SECRET=


# ── Billing (Stripe) ────────────────────────────────────────────────────────

# Stripe secret key. dashboard.stripe.com → Developers → API keys. Use sk_test_ in dev.
STRIPE_SECRET_KEY=
# Signing secret for the main webhook endpoint (whsec_…). `stripe listen` prints one for local use.
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_…) for the three subscription tiers. Stripe → Product catalogue.
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Stripe Connect — tenants taking payments in their own name. "true" to enable at all.
STRIPE_CONNECT_ENABLED=
# Connect OAuth client id (ca_…). Stripe → Settings → Connect → OAuth settings.
STRIPE_CONNECT_CLIENT_ID=
# Signing secret for the SEPARATE Connect webhook endpoint. Not the same value as above.
STRIPE_CONNECT_WEBHOOK_SECRET=


# ── Meta (Instagram and Facebook inbox) ─────────────────────────────────────

# Meta app id and secret. developers.facebook.com → your app → Settings → Basic.
META_APP_ID=
META_APP_SECRET=
# Token you invent, then paste into the Meta webhook config so the GET handshake matches.
META_VERIFY_TOKEN=
# Facebook Login for Business configuration id, if the app uses one.
META_CONFIG_ID=


# ── Calendar OAuth ──────────────────────────────────────────────────────────

# Google OAuth client. console.cloud.google.com → APIs & Services → Credentials.
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft/Entra app registration. portal.azure.com → App registrations.
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/microsoft/calendar/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=


# ── QuickBooks Online ───────────────────────────────────────────────────────

# Intuit app keys. developer.intuit.com → your app → Keys & credentials.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must match Intuit EXACTLY: <NEXT_PUBLIC_APP_URL>/api/quickbooks/callback
QBO_REDIRECT_URI=
# "production" or "sandbox". ANY other value — including "production " with a
# stray space — silently means sandbox, which is the safe way to fail.
QBO_ENVIRONMENT=


# ── Secrets the app issues and checks itself ────────────────────────────────

# 32 bytes, hex (64 chars) or base64. Encrypts stored OAuth tokens and signs the
# QuickBooks state parameter. Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=
# Bearer secret every cron route requires. Vercel injects this for Vercel Crons;
# set it yourself to call one by hand. FAIL-CLOSED: unset means no cron runs.
CRON_SECRET=
# Shared secret between this app and the Ask Amy realtime proxy, so the proxy
# only accepts sessions this app has signed. Any long random string; must match
# AMY_REALTIME_SECRET on the proxy.
AMY_REALTIME_SECRET=
# wss:// URL of that proxy, e.g. wss://amy-realtime-server.onrender.com.
# Defaults to ws://localhost:8081 when empty.
NEXT_PUBLIC_AMY_REALTIME_URL=


# ── Rate limiting (Upstash Redis) ───────────────────────────────────────────
# Set EITHER pair. The Vercel Upstash integration injects the KV_REST_API_*
# names; a hand-made Upstash database gives you the UPSTASH_* ones. Both unset
# means the limiter is disabled, which is fine locally.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=


# ── Platform admin ──────────────────────────────────────────────────────────

# Comma-separated emails treated as platform admins. Defaults to the owner's
# address in code when empty — set it, or you inherit that default.
ADMIN_EMAILS=
# Single address for operational alert emails. Falls back to the same default.
ADMIN_EMAIL=
# E.164 number for operational alert texts. Empty = no admin SMS.
ADMIN_PHONE=
# "1" to put HTTP basic auth in front of /admin. Off unless set.
ADMIN_BASIC_AUTH=
# The password that basic auth checks. Only read when ADMIN_BASIC_AUTH=1.
ADMIN_PASSWORD=


# ── Feature flags — all default OFF unless stated ───────────────────────────

# Comma-separated tenant ids allowed into the /v2 preview. Empty = admins only.
V2_TENANT_IDS=
# "true" to let a partner operate a client workspace (White Label operator plane).
WL_OPERATOR_ENABLED=
# "true" to enable prepaid White Label balance billing.
WL_BILLING_ENABLED=
# "true" to charge partners the platform fee.
WL_PLATFORM_FEE_ENABLED=
# Days of grace before an unpaid platform fee bites. Defaults to a value in code.
WL_PLATFORM_GRACE_DAYS=
# "true" lets an admin sync platform-fee state against LIVE Stripe. Leave empty.
WL_PLATFORM_ADMIN_SYNC_PROD=
# Price id (price_…) for the White Label platform fee subscription.
STRIPE_WL_PLATFORM_PRICE_ID=
# "true" to let partner cron routes run, including automatic payouts. Kill switch.
PARTNER_CRON_ENABLED=
# Base URL of the partner-facing app, when it differs. Falls back to NEXT_PUBLIC_APP_URL.
PARTNER_APP_URL=
# Minimum partner payout in cents. Defaults to 5000 ($50).
PARTNER_MIN_PAYOUT_CENTS=
# Days a commission is held before it can be approved. Defaults to 30.
PARTNER_COMMISSION_HOLD_DAYS=
# "true" to open the CEO Command Center.
CEO_COMMAND_CENTER_ENABLED=
# "true" to let the AI greet a recognised customer by name in TEXT as well as voice.
CUSTOMER_RECOGNITION_TEXT_ENABLED=


# ── Learning jobs — these spend money, read the comments ────────────────────

# "false" hard-disables all LLM learning. This is the ONE flag that defaults ON.
LEARNING_ENABLED=
# "true" to let the learning cron run. Defaults OFF — leave it off until a real
# tenant has been tested by hand.
LEARNING_CRON_ENABLED=
# "true" to log learning runs in production. Always logs outside production.
LEARNING_LOG=
# Per-job spend caps in DOLLARS. Defaults: 5 for the one-time import, 0.10 after.
LEARNING_INITIAL_MAX_COST=
LEARNING_INCREMENTAL_MAX_COST=
# How far back the first import reads, in months. Default 10.
LEARNING_HISTORY_MONTHS=
# Row and batch caps. Defaults: 5000 initial rows, 200 per incremental job.
LEARNING_INITIAL_MAX_RECORDS=
LEARNING_INCREMENTAL_BATCH=
# Records sampled for synthesis. Defaults: 80 initial, 20 incremental.
LEARNING_SAMPLE_INITIAL=
LEARNING_SAMPLE_INCREMENTAL=
# Representatives per synthesis call. Default 20.
LEARNING_CHUNK=
# Hard ceilings per run. Defaults: 3000 messages, 12 LLM calls, 400000 tokens.
LEARNING_MAX_MESSAGES=
LEARNING_MAX_CALLS_RUN=
LEARNING_MAX_TOKENS_RUN=


# ── Catalog ingestion tuning ────────────────────────────────────────────────

# Max URLs a single site crawl will follow. Default 2000.
CATALOG_MAX_CRAWL_URLS=
# Milliseconds the AI will wait for a catalog lookup mid-conversation. Default 250.
CATALOG_RETRIEVAL_TIMEOUT_MS=
# Any non-empty value prints ingestion fetch failures to the server log.
INGESTION_DEBUG=


# ── Test-only ───────────────────────────────────────────────────────────────

# "1" opts into the billing suite that talks to REAL Stripe test-mode. Off in CI.
PHASE6_LIVE=


# ============================================================================
# SIDECAR SERVICES — separate deployments, their own environments, NOT this file
# ============================================================================
#
# amy-realtime-server/  (Render blueprint at render.yaml — the dashboard-voice proxy)
#   DEEPGRAM_API_KEY       same key as above
#   ANTHROPIC_API_KEY      same key as above
#   AMY_REALTIME_SECRET    must match this app's value
#   AMY_REALTIME_PORT      or PORT — the host usually sets it
#
# voice-server/  (the Twilio media-stream leg)
#   TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_PHONE_NUMBER
#   DEEPGRAM_API_KEY / ANTHROPIC_API_KEY
#   NEXT_PUBLIC_APP_URL    where it calls back into this app
#   DEFAULT_SYSTEM_PROMPT / DEFAULT_VOICE   fallbacks when a tenant has none
#   PORT
#
# catalog-worker/  (background catalog ingestion)
#   SUPABASE_URL           note the name: NOT the NEXT_PUBLIC_ one, though it reads that too
#   SUPABASE_SERVICE_ROLE_KEY / ANTHROPIC_API_KEY
#   CATALOG_WORKER_CONCURRENCY / CATALOG_WORKER_POLL_MS
